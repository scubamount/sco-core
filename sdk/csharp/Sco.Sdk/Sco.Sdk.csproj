<Project Sdk="Microsoft.NET.Sdk">

  <!-- Sco.Sdk: the C# layer of the sco plugin SDK (docs/sdk-csharp.md). No package references:
       a plugin references this project and publishes itself with NativeAOT. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Sco.Sdk</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <!-- Trimming and AOT analyzers on: no reflection-heavy code may creep in. -->
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

</Project>
